# =============================================================================
# .env.example — Template for the root .env file (used by docker-compose)
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git — it contains secrets.
# =============================================================================

# Clerk Authentication
# Get from: https://dashboard.clerk.com → Your App → API Keys
# Use the TEST keys for local development
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json

# VAPID Keys (for push notifications)
# Generate new keys: npx web-push generate-vapid-keys
# OR copy from your existing backend/.env
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
