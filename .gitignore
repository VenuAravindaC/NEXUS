# Root gitignore for NEXUS monorepo

# Environment files - NEVER commit secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies (handled per-project)
node_modules

# Build outputs (handled per-project)
dist
dist-ssr
build
target

.vscode
.claude
CLAUDE.md
INTERVIEW_NOTES.md
learning/
designs/

# Certificates & keys - NEVER commit these
*.pem
*.key
*.p12
*.jks
*.crt
vapid-keys.json